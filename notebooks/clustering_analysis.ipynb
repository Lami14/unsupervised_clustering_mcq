# Load and inspect data
import pandas as pd
from src.data_processing import load_data, check_nulls_fill, scale_features
from src.clustering_models import kmeans_cluster, hierarchical_cluster
from src.evaluation import silhouette, db_index
import matplotlib.pyplot as plt
import seaborn as sns

# Load dataset
data = load_data('../data/mall_customers.csv')
data = check_nulls_fill(data)

# Scatter plot of Annual Income vs Spending Score
plt.figure(figsize=(8,6))
sns.scatterplot(x='Annual_Income_(k$)', y='Spending_Score', data=data)
plt.title('Annual Income vs Spending Score')
plt.show()

# Scale features
features = ['Annual_Income_(k$)', 'Spending_Score']
X_scaled = scale_features(data, features)

# K-Means clustering
kmeans = kmeans_cluster(X_scaled, n_clusters=5)
data['KMeans_Cluster'] = kmeans.labels_

